rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function verifiedUser() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    match /users/{userId}/monitoring_records/{recordId} {
      allow read, delete: if verifiedUser()
        && request.auth.uid == userId;

      allow create: if verifiedUser()
        && request.auth.uid == userId
        && request.resource.data.id == recordId
        && request.resource.data.mask_base64 is string
        && request.resource.data.mask_base64.size() <= 650000
        && request.resource.data.timestamp is timestamp
        && request.resource.data.plant_id is string
        && request.resource.data.location is string
        && request.resource.data.green_ratio is number
        && request.resource.data.yellow_ratio is number
        && request.resource.data.prediction is string
        && request.resource.data.confidence is number
        && request.resource.data.health_score is number
        && request.resource.data.severity is string;

      // Monitoring results are history records, not user-editable documents.
      allow update: if false;
    }
  }
}
